{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jlproject",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-06",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "env": {
    "e2e": {
      "name": "jlproject-e2e",
      "vars": {
        "JLPROJECT_ENV": "e2e"
      },
      "workers_dev": false
    },
    "production": {
      "name": "jlproject",
      "vars": {
        "JLPROJECT_ENV": "production"
      },
      "workers_dev": true,
      "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      }
    }
  }
}
