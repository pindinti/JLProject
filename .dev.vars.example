# Development-only Worker configuration. Copy this file to .dev.vars.
# Keep the real value local; never commit it or expose it to the browser.
DATABASE_URL=
JLPROJECT_ENV=development
NEON_AUTH_BASE_URL=
# Project-scoped Neon organization API key for development-only Auth user creation.
# Never use a personal or organization-wide key here.
NEON_MANAGEMENT_API_KEY=
